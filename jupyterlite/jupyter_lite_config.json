{
  "LiteAppConfig": {
    "pyodide_url": "https://cdn.jsdelivr.net/pyodide/v0.26.2/full/",
    "apps": ["notebook", "lab"],
    "output_dir": "_output",
    "base_url": "/jupyter/"
  },
  "PyodideAddon": {
    "pyodide_packages": ["numpy", "pandas", "matplotlib", "scikit-learn"]
  },
  "SettingsAddon": {
    "@jupyterlab/translation-extension:plugin": {
      "locale": "zh_CN"
    }
  }
}
